services:
  feedback:
    image: ghcr.io/interfacerproject/interfacer-feedback-service:latest
    container_name: interfacer-feedback
    restart: always
    ports:
      - "{{ feedback_port }}:8081"
    environment:
      - HOST=0.0.0.0
      - PORT=8081
      - GIN_MODE=release
      - SQLITE_PATH=/data/feedback.db
    volumes:
      - {{ feedback_basedir }}/data:/data
    logging:
      driver: "json-file"
      options:
        max-file: "5"
        max-size: "15m"
